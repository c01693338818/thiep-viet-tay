# Copy file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng server-side (Server Actions / Route Handlers). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (giai đoạn 4) – email thông báo đơn mới
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=ban@example.com

# Thông tin shop
NEXT_PUBLIC_SHOP_NAME=Thiệp Viết Tay
# URL công khai của site (dùng cho sitemap, Open Graph). Đổi khi có domain riêng.
NEXT_PUBLIC_SITE_URL=https://thiep-viet-tay.vercel.app
# Liên hệ hiển thị ở trang Giới thiệu (để trống thì không hiện)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Admin (giai đoạn 5) – email được phép vào /admin, cách nhau bằng dấu phẩy.
# Tài khoản phải tồn tại trong Supabase → Authentication → Users.
ADMIN_EMAILS=admin@example.com

# Chuyển khoản (giai đoạn 4) – để trống thì trang đơn hàng chỉ ghi "sẽ liên hệ"
# NEXT_PUBLIC_BANK_ID: mã ngân hàng theo VietQR, VD: VCB, TCB, MB, ACB, BIDV, VPB, TPB
NEXT_PUBLIC_BANK_ID=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=
