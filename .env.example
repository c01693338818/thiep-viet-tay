# Copy file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng server-side (Server Actions / Route Handlers). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (giai đoạn 4) – email thông báo đơn mới
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=ban@example.com

# Thông tin shop
NEXT_PUBLIC_SHOP_NAME=Thiệp Viết Tay
